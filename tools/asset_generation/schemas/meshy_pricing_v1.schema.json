{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic-sea.invalid/schemas/meshy_pricing_v1.schema.json",
  "title": "Meshy pricing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_kind",
    "pricing_id",
    "checked_at",
    "expires_at",
    "source_url",
    "costs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_kind": { "const": "meshy_pricing" },
    "pricing_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_url": {
      "const": "https://docs.meshy.ai/api/pricing.md"
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_to_3d", "multi_image_to_3d"],
      "properties": {
        "image_to_3d": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart-topology"],
          "properties": {
            "smart-topology": {
              "type": "object",
              "additionalProperties": false,
              "required": ["meshy-t2"],
              "properties": {
                "meshy-t2": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["untextured"],
                  "properties": {
                    "untextured": { "const": 5 }
                  }
                }
              }
            }
          }
        },
        "multi_image_to_3d": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard"],
          "properties": {
            "standard": {
              "type": "object",
              "additionalProperties": false,
              "required": ["meshy-7", "latest"],
              "properties": {
                "meshy-7": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["untextured"],
                  "properties": {
                    "untextured": { "const": 20 }
                  }
                },
                "latest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["untextured"],
                  "properties": {
                    "untextured": { "const": 20 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
